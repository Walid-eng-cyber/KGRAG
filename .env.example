# ---- Copy this file to .env and fill in the values ----

# Ollama = local, open-source LLM used for entity/relationship extraction.
# No API key, no cost. Install Ollama (https://ollama.com), then:
#     ollama pull llama3.1:8b
# Alternatives that also do well at structured extraction:
#     qwen2.5:7b   (often better at strict JSON/tool output)
#     mistral-nemo
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# ---- Hosted chat model (optional) ----
# Leave LLM_PROVIDER=ollama for fully local runs. To try Kimi K3.1 Pro (Moonshot,
# OpenAI-compatible; $2 / $10 per 1M input/output tokens), set:
#     LLM_PROVIDER=openai
#     LLM_BASE_URL=https://api.moonshot.ai/v1
#     LLM_API_KEY=<your Moonshot key>
#     EXTRACT_MODEL=kimi-k3.1-pro
#     ROUTER_MODEL=kimi-k3.1-pro
#     ANSWER_MODEL=kimi-k3.1-pro
# Embeddings (EMBED_MODEL=bge-m3) still run on Ollama, so keep it running.
LLM_PROVIDER=ollama
LLM_BASE_URL=https://api.moonshot.ai/v1
LLM_API_KEY=

# Neo4j connection (matches docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
# Pick your own passwords. docker-compose.yml reads the same values from .env.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
NEO4J_PASSWORD=

# Postgres + pgvector connection (matches docker-compose.yml)
PG_HOST=localhost
PG_PORT=5434
PG_DB=kgrag
PG_USER=postgres
PG_PASSWORD=

# SEC EDGAR requires a descriptive User-Agent with a contact email.
# Replace with your own name + email (SEC blocks generic/empty agents).
SEC_USER_AGENT=Your Name you@example.com

# Per-filing character cap for extraction (keeps runs fast on a local model).
# A full 10-K is huge; smaller is faster. Raise once it works.
MAX_FILING_CHARS=40000

# ---- Web UI sign-in (optional; leave GOOGLE_CLIENT_ID empty for open local use) ----
# Create an OAuth client ID (type "Web application") in Google Cloud Console and
# add your site's URL under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
# Comma-separated admin Google accounts. Admins are approved automatically and
# approve everyone else's sign-ups (Accounts page, or: python -m server.users).
ADMIN_EMAILS=
# Where accounts are stored (SQLite). data/ is gitignored.
USERS_DB=data/users.db
# Random string, 32+ characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_TTL_HOURS=12
# Keep 1 behind HTTPS. Set 0 only to test over plain http://localhost.
COOKIE_SECURE=1
# Questions per user per minute (0 disables the limit).
RATE_LIMIT_PER_MIN=10

# ---- Hardening (see README "Deploying") ----
# Exact origins allowed to call the API from a browser, comma-separated, when the
# UI is hosted on a different domain. Leave empty when the API serves the UI.
CORS_ORIGINS=
# lax = UI and API on the same site. none = UI on another domain (needs HTTPS).
COOKIE_SAMESITE=lax
# 1 enables the interactive API docs at /docs. Keep 0 on public servers.
KGRAG_DOCS=0

# ---- Client billing (usage monitoring per account) ----
# Price every LLM call as this hosted model, even when a local model ran it, to see
# what an external provider would cost. Empty = each model's own rate (local = 0).
BILLING_PRICE_AS=claude-sonnet-5-5
# Provider prices are USD; client credit and reports are EUR. Update to the current rate.
USD_TO_EUR=0.86
# Monthly usage credit for each new client account, in EUR.
DEFAULT_MONTHLY_CREDIT_EUR=2500
